{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.johnmschoonover.decksync",
  "Name": "Deck Sync",
  "Version": "0.1.0.0",
  "Author": "John Schoonover",
  "Category": "Deck Sync",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "Description": "Keep multiple Stream Deck devices on matching pages. Group devices into scopes with a parent and children; changing pages on any deck in a scope drives the others to their mapped pages, with the parent always authoritative.",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "13.0" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "PropertyInspectorPath": "ui/propertyInspector.html",
  "Actions": [
    {
      "Name": "Page Anchor",
      "UUID": "com.johnmschoonover.decksync.anchor",
      "Icon": "imgs/actions/anchor/icon",
      "Tooltip": "Place on a page to sync other devices when this page becomes active.",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/anchor.html",
      "States": [
        {
          "Image": "imgs/actions/anchor/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ]
}